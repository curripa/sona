---

---

<div id="player-bar" class="fixed bottom-0 inset-x-0 z-50 bg-base-surface border-t border-base-border">
  <div
    id="pb-track"
    role="slider"
    data-i18n-aria="player.progress_aria"
    aria-label="Progreso"
    aria-valuemin="0"
    aria-valuemax="0"
    aria-valuenow="0"
    tabindex="0"
    class="h-1 bg-base-border relative cursor-pointer before:absolute before:-inset-y-1 before:inset-x-0 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent"
  >
    <div id="pb-progress" class="h-full bg-accent pointer-events-none" style="width:0%"></div>
  </div>
  <div class="max-w-6xl mx-auto px-4 py-3 flex md:grid md:grid-cols-[1fr_auto_1fr] items-center gap-3 md:gap-4">
    <div class="flex items-center gap-3 min-w-0 flex-1">
      <img
        id="pb-cover"
        src=""
        alt=""
        class="w-12 h-12 rounded object-cover shrink-0"
        style="visibility:hidden"
        onerror="this.style.visibility='hidden'"
      />
      <div class="min-w-0 flex-1">
        <p id="pb-title" class="truncate font-bold text-sm" data-i18n="player.empty_title">Nada en reproducción</p>
        <p id="pb-album" class="truncate text-xs opacity-60" data-i18n="player.empty_album">Elige un álbum del catálogo</p>
        <p id="pb-band" class="truncate text-xs opacity-60"></p>
      </div>
    </div>
    <div class="flex items-center gap-3 shrink-0 justify-end md:justify-center">
      <button id="pb-repeat" data-i18n-aria="player.repeat_off" aria-label="Repetir desactivado" class="w-8 h-8 flex items-center justify-center hover:opacity-60 opacity-40 text-zinc-100" title="Repetir">
        <span class="relative inline-flex items-center justify-center">
          <span class="text-xl leading-none">∞</span>
          <span id="pb-repeat-badge" class="absolute -top-1 -right-2 text-[9px] font-bold leading-none hidden">1</span>
        </span>
      </button>
      <button id="pb-prev" data-i18n-aria="player.prev" aria-label="Anterior" class="text-xl hover:opacity-60">⏮</button>
      <button id="pb-toggle" data-i18n-aria="player.play" aria-label="Reproducir" class="w-10 h-10 rounded-full bg-accent flex items-center justify-center text-lg">▶</button>
      <button id="pb-next" data-i18n-aria="player.next" aria-label="Siguiente" class="text-xl hover:opacity-60">⏭</button>
      <button id="pb-shuffle" data-i18n-aria="player.shuffle" aria-label="Mezcla aleatoria" class="w-8 h-8 flex items-center justify-center hover:opacity-60 disabled:opacity-30 disabled:cursor-not-allowed text-zinc-100" title="Mezcla aleatoria">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
      </button>
    </div>
    <div class="hidden md:flex justify-end shrink-0 tabular-nums text-xs opacity-70">
      <span class="inline-flex items-center gap-1"><span id="pb-cur">0:00</span><span class="opacity-50">/</span><span id="pb-dur">0:00</span></span>
    </div>
  </div>
</div>
